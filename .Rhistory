library(ggplot2)
library(gam)
#part 1a)
orc_data <- read.csv('ORC162.csv')
orc_data$Date <- as.Date(orc_data$Date)
#head(orc_data)
#plot(orc_data$Date, orc_data$Q)
orc_graph <- ggplot(orc_data, aes(Date, Q)) + geom_point()
orc_graph
#part 1b)
gammodel <- gam(Q ~ Date + s(Date, spar = 0.3), data = orc_data)
summary(gammodel)
#part 1c)
orc_data$gam1fitted <- predict(gammodel)
orc_graph2 <- orc_graph + geom_line(data = orc_data, aes(x=Date, y=gam1fitted), color = 'red')
orc_graph2
#part 1d
gammodel2 <- gam(Q ~ Date + s(Date, spar = 0.5), data = orc_data)
orc_data$gam2fitted <- predict(gammodel2)
orc_graph3 <- plot(orc_graph + geom_line(data = orc_data, aes(x=Date, y=gam2fitted), color = 'red'))
gammodel3 <- gam(Q ~ Date + s(Date, spar = 0.7), data = orc_data)
orc_data$gam3fitted <- predict(gammodel3)
orc_graph4 <- plot(orc_graph + geom_line(data = orc_data, aes(x=Date, y=gam3fitted), color = 'red'))
gammodel4 <- gam(Q ~ Date + s(Date, spar = 0.1), data = orc_data)
orc_data$gam4fitted <- predict(gammodel4)
orc_graph5 <- plot(orc_graph + geom_line(data = orc_data, aes(x=Date, y=gam4fitted), color = 'red'))
#part 1e)
#part 2a)
efs <- read.csv('EFs.csv')
efslm <- lm(log(EmissionFactor) ~ factor(ManureType),data = efs)
summary(efslm)
qqnorm(resid(efslm))
qqline(resid(efslm))
plot(fitted(efslm), resid(efslm))
abline(0,0)
#part 2b no adjustment)
#treatment means
#tapply(X=log(efs$EmissionFactor), INDEX = list(efs$ManureType), FUN = mean)
efsaov <- aov(log(efs$EmissionFactor) ~ ManureType, efs)
summary(efsaov)
#pairwise test for no adjustment for multiple comparisons
pairwise.t.test(log(efs$EmissionFactor), efs$ManureType, p.adj = "none")
#part 2b adjustment 1)
pairwise.t.test(log(efs$EmissionFactor), efs$ManureType, p.adj="bonferroni", console=TRUE)
#part 2b adjustment 2)
pairwise.t.test(log(efs$EmissionFactor), efs$ManureType, p.adj = 'poo', console=TRUE)
#part 2b adjustment 2)
pairwise.t.test(log(efs$EmissionFactor), efs$ManureType, p.adj = 'holm', console=TRUE)
#part 2b adjustment 2)
pairwise.t.test(log(efs$EmissionFactor), efs$ManureType, p.adj = 'holm', console=TRUE)
#part 2b adjustment 2)
pairwise.t.test(log(efs$EmissionFactor), efs$ManureType, p.adj = 'holm', console=TRUE)
#part 2b adjustment 2)
pairwise.t.test(log(efs$EmissionFactor), efs$ManureType, p.adj = 'holm', console=TRUE)
#part 2b adjustment 1)
pairwise.t.test(log(efs$EmissionFactor), efs$ManureType, p.adj="bonferroni", console=TRUE)
#part 2d)
library(predictmeans)
# You may need to download this package from CRAN
#for the predictmeans function categorical predictors must be factors.
#The following line of code converts the ManureType variable into a factor.
EFs$ManureType <- as.factor(Efs$ManureType)
#part 2d)
library(predictmeans)
# You may need to download this package from CRAN
#for the predictmeans function categorical predictors must be factors.
#The following line of code converts the ManureType variable into a factor.
efs$ManureType <- as.factor(Efs$ManureType)
#part 2d)
library(predictmeans)
# You may need to download this package from CRAN
#for the predictmeans function categorical predictors must be factors.
#The following line of code converts the ManureType variable into a factor.
efs$ManureType <- as.factor(Efs$ManureType)
#part 2d)
library(predictmeans)
# You may need to download this package from CRAN
#for the predictmeans function categorical predictors must be factors.
#The following line of code converts the ManureType variable into a factor.
efs$ManureType <- as.factor(efs$ManureType)
m3 <- lmer(log(EmissionFactor) ~ ManureType + (1|InstituteName), data=efs)
summary(m3)
#The following code will calculate means and multiple comparisons with a Tukey adjustment.
predictmeans(m3, "ManureType",pairwise=TRUE,adj="tukey", Df=100)
