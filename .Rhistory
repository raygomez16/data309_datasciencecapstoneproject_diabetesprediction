scale_y_continuous(breaks = seq(0, max(table(dataset_new$heart_disease)), by = 10000)) +
labs(
title = "Heart Disease and Diabetes Breakdown",
x = "Diabetes Status",
y = "Count",
fill = "Heart Disease Status"
) +
theme_minimal() +
theme(
plot.title = element_text(hjust = 0.5, size = 14)
)
