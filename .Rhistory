library(lme4)
library(readxl)
library(ggplot2)
#Importing dataset
seeds <- read_xlsx('CNGSeedData.xlsx')
head(seeds)
trial4 <- read.csv('Trial4.csv')
#part a) % of seeds that passed through
seeds$pass_through <- round(seeds$seeds_passed / seeds$Nseeds, digits = 4)
#seeds$pass_through
head(seeds)
graph1 <- ggplot(seeds, aes(x = sieve_size, y = pass_through, color = seed_status, group = seed_status)) + geom_jitter() + labs(x =  'Sieve Size ', y = 'Pass Through (Percentage)')
graph1
#part b)
#fitting fixed effects generalized linear model.
y <- cbind(seeds$seeds_passed, seeds$Nseeds - seeds$seeds_passed)
glm_seeds <- glmer(y ~ sieve_size*seed_status + (1|Rep), data = seeds, family = binomial)
summary(glm_seeds)
#part d)
#par(mfrow = c(1,3))
qqnorm(resid(glm_seeds), main = "Residual Plots")
qqline(resid(glm_seeds))
hist(resid(glm_seeds), main = "Histogram of Residuals")
plot(fitted(glm_seeds), resid(glm_seeds), xlab = "Fitted", ylab = "Residuals")
abline(0,0)
#part e)
#plot(fitted(glm_seeds), seeds$pass_through)
seeds$fittedseeds <- round(fitted(glm_seeds), digits = 4)
ggplot(seeds, aes(x = fittedseeds, y = pass_through , color = seed_status)) + geom_point() + labs(x = 'Fitted Seeds', y = 'Passed Through')
